rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CATÁLOGO GLOBAL DE JUGADORES
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;

      // El creador puede modificar todo.
      // Cualquier usuario autenticado puede añadir/quitar linkedUserId
      // (necesario para vincular compañeros por email).
      allow update: if request.auth != null
                    && (resource.data.createdByUserId == request.auth.uid
                        || !('createdByUserId' in resource.data)
                        || (request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['linkedUserId', 'updatedAt'])));

      allow delete: if request.auth != null
                    && resource.data.createdByUserId == request.auth.uid;
    }

    // DIRECTORIO PÚBLICO de emails -> uid
    // Permite buscar un UID por email para vincular cuentas entre usuarios.
    // Solo contiene uid y email, sin datos sensibles.
    match /userLookup/{emailKey} {
      allow read: if request.auth != null;
      // Solo el propio usuario puede crear/actualizar su entrada
      allow write: if request.auth != null
                   && request.auth.uid == request.resource.data.uid;
    }

    // DATOS DE USUARIO + TODAS las subcolecciones
    // rounds, templates, gamePresets, playerLinks, favoriteCourses
    match /users/{userId} {
      // Permitir leer el documento raíz a usuarios autenticados
      // Necesario para buscar UID por email al vincular compañeros.
      allow read: if request.auth != null;

      // Solo el propio usuario puede escribir en sus datos
      allow write: if request.auth != null
                   && request.auth.uid == userId;

      // Subcolecciones: solo el propio usuario por defecto
      match /{document=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // liveRoundRefs: también el organizador de una ronda en vivo puede escribir
      // Necesario para que publishRound() entregue invitaciones a los jugadores
      match /liveRoundRefs/{roundId} {
        allow read, write: if request.auth != null
                           && (request.auth.uid == userId
                               || (exists(/databases/$(database)/documents/liveRounds/$(roundId))
                                   && get(/databases/$(database)/documents/liveRounds/$(roundId)).data.ownerUid == request.auth.uid));
      }
    }

    // RONDAS EN VIVO (multijugador en tiempo real)
    match /liveRounds/{roundId} {
      // Permitir leer/actualizar si:
      //   1. El usuario está en participantUids (caso normal), O
      //   2. El usuario es el ownerUid (fallback: participantUids puede estar vacío
      //      durante la creación inicial o en edge cases de timing).
      // IMPORTANTE: verificar que 'participantUids' existe antes de usar 'in'.
      // Si el campo está ausente (ronda sin jugadores vinculados), Firestore lanza
      // un error de evaluación que se manifiesta como error de transporte en la app
      // en lugar de un PERMISSION_DENIED claro.
      allow read, update: if request.auth != null
                          && (
                            (('participantUids' in resource.data)
                              && request.auth.uid in resource.data.participantUids)
                            || request.auth.uid == resource.data.ownerUid
                          );
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;

      // Invitaciones: el invitado puede leer/escribir su propio doc ({uid} == su uid)
      // El organizador puede leer/escribir cualquier invitación de la ronda.
      // IMPORTANTE: no usar get(liveRounds/...) aquí para evitar que el invitado
      // necesite acceso previo al documento padre (chicken-and-egg).
      match /invitations/{uid} {
        // El invitado puede leer y actualizar únicamente su propia invitación
        allow read, update: if request.auth != null
                            && request.auth.uid == uid;
        // El organizador (en participantUids) puede crear y leer todas
        allow read, write: if request.auth != null
                           && exists(/databases/$(database)/documents/liveRounds/$(roundId))
                           && request.auth.uid == get(/databases/$(database)/documents/liveRounds/$(roundId)).data.ownerUid;
      }
    }

  }
}
