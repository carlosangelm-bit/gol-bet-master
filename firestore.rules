rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // CATÁLOGO GLOBAL DE JUGADORES
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;

      // El creador puede modificar todo.
      // Cualquier usuario autenticado puede añadir/quitar linkedUserId
      // (necesario para vincular compañeros por email).
      allow update: if request.auth != null
                    && (resource.data.createdByUserId == request.auth.uid
                        || !('createdByUserId' in resource.data)
                        || (request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['linkedUserId', 'updatedAt'])));

      allow delete: if request.auth != null
                    && resource.data.createdByUserId == request.auth.uid;
    }

    // DIRECTORIO PÚBLICO de emails -> uid
    // Permite buscar un UID por email para vincular cuentas entre usuarios.
    // Solo contiene uid y email, sin datos sensibles.
    match /userLookup/{emailKey} {
      allow read: if request.auth != null;
      // Solo el propio usuario puede crear/actualizar su entrada
      allow write: if request.auth != null
                   && request.auth.uid == request.resource.data.uid;
    }

    // DATOS DE USUARIO + TODAS las subcolecciones
    // rounds, templates, gamePresets, playerLinks, favoriteCourses
    match /users/{userId} {
      // ── Solo el propio usuario lee su documento raíz ──────────────────────
      //
      // Antes era `if request.auth != null`: cualquier usuario autenticado podía
      // leer el perfil de cualquier otro conociendo su uid, y ahí está el CORREO,
      // además del apodo, el handicap por defecto y la moneda.
      //
      // El comentario decía que hacía falta "para buscar UID por email al
      // vincular compañeros", y no: para eso está /userLookup, que solo tiene
      // uid y email. El propio código lo dice en player_service —"esta colección
      // evita hacer queries sobre /users (que requieren permisos de leer datos
      // de otros usuarios)"— así que el permiso estaba MUERTO y solo exponía.
      //
      // Lo encontró una prueba de reglas escrita para el torneo compartido, no
      // una revisión. Los accesos cruzados que la app sí necesita van a
      // subcolecciones concretas —liveRoundRefs— con su propia regla.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Solo el propio usuario puede escribir en sus datos
      allow write: if request.auth != null
                   && request.auth.uid == userId;

      // Subcolecciones: solo el propio usuario por defecto
      match /{document=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // liveRoundRefs: también el organizador de una ronda en vivo puede escribir
      // Necesario para que publishRound() entregue invitaciones a los jugadores
      match /liveRoundRefs/{roundId} {
        allow read, write: if request.auth != null
                           && (request.auth.uid == userId
                               || (exists(/databases/$(database)/documents/liveRounds/$(roundId))
                                   && get(/databases/$(database)/documents/liveRounds/$(roundId)).data.ownerUid == request.auth.uid));
      }
    }

    // RONDAS EN VIVO (multijugador en tiempo real)
    match /liveRounds/{roundId} {
      // Permitir leer/actualizar si:
      //   1. El usuario está en participantUids (caso normal), O
      //   2. El usuario es el ownerUid (fallback: participantUids puede estar vacío
      //      durante la creación inicial o en edge cases de timing).
      // IMPORTANTE: verificar que 'participantUids' existe antes de usar 'in'.
      // Si el campo está ausente (ronda sin jugadores vinculados), Firestore lanza
      // un error de evaluación que se manifiesta como error de transporte en la app
      // en lugar de un PERMISSION_DENIED claro.
      allow read, update: if request.auth != null
                          && (
                            (('participantUids' in resource.data)
                              && request.auth.uid in resource.data.participantUids)
                            || request.auth.uid == resource.data.ownerUid
                          );
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;

      // Invitaciones: el invitado puede leer/escribir su propio doc ({uid} == su uid)
      // El organizador puede leer/escribir cualquier invitación de la ronda.
      // IMPORTANTE: no usar get(liveRounds/...) aquí para evitar que el invitado
      // necesite acceso previo al documento padre (chicken-and-egg).
      match /invitations/{uid} {
        // El invitado puede leer y actualizar únicamente su propia invitación
        allow read, update: if request.auth != null
                            && request.auth.uid == uid;
        // El organizador (en participantUids) puede crear y leer todas
        allow read, write: if request.auth != null
                           && exists(/databases/$(database)/documents/liveRounds/$(roundId))
                           && request.auth.uid == get(/databases/$(database)/documents/liveRounds/$(roundId)).data.ownerUid;
      }
    }

    // ══════════════════════════════════════════════════════════════════════
    // TORNEOS COMPARTIDOS
    // ══════════════════════════════════════════════════════════════════════
    //
    // Un torneo vive en users/{uid}/torneos y su tabla se DERIVA de
    // users/{uid}/roundResults. Un invitado no puede leer eso, y no debe: son
    // TODAS las rondas del organizador, no las del torneo.
    //
    // Así que compartir es PUBLICAR UNA COPIA: un documento autocontenido con lo
    // del torneo y nada más. Clasificación, botes, participantes. NO los
    // RoundResult completos, NO balances de rondas ajenas, NO el directorio.
    //
    // Y eso es lo que hace segura esta regla: es `read` sobre un documento que
    // solo contiene lo que se quiso compartir. Sin get() cruzados, sin
    // condiciones sobre users/** que alguien tenga que razonar. El criterio se
    // cumple POR CONSTRUCCIÓN, no porque la regla esté bien escrita — que es
    // mejor, porque no depende de que lo esté.
    //
    // Revocar un enlace es borrar el documento.
    // ══════════════════════════════════════════════════════════════════════
    // RESULTADOS PUBLICADOS A UN TORNEO AJENO
    // ══════════════════════════════════════════════════════════════════════
    //
    // El caso: una LIGA DE TEMPORADA. Cada jugador marca sus propias rondas y
    // las cierra él, así que su resultado cae en users/{suUid}/roundResults y el
    // organizador no lo ve. La tabla contaba menos rondas de las que había, sin
    // avisar.
    //
    // Con el shotgun no pasa —el organizador es dueño de todas— y por eso allí
    // esta colección sobra. Aquí hace falta.
    //
    // ── Lo que hace segura la escritura, sin tocar users/** ────────────────
    //
    // Quien escribe tiene que demostrar DOS cosas, y las dos se comprueban
    // leyendo documentos que ya puede leer:
    //
    //   1 · Que escribe a su nombre: escritoPor == su uid. Sin esto, cualquiera
    //       podría publicar un resultado firmado por otro.
    //   2 · Que el organizador que declara es el DE VERDAD: se compara contra
    //       sharedTorneos/{token}.ownerUid, que es público-para-autenticados y
    //       lo escribe solo el dueño del torneo. Sin esto, se podría meter una
    //       fila en la tabla de un desconocido.
    //
    // NINGUNA de las dos condiciones lee users/**, así que la propiedad que
    // importaba —que nadie escribe ni lee bajo la cuenta de otro— se conserva.
    //
    // ── Lo que la regla NO puede comprobar, y cómo se cubre ────────────────
    //
    // No puede verificar que quien escribe JUGÓ esa ronda: la ronda de una liga
    // no es una ronda en vivo, así que no hay documento compartido que lo diga.
    // O sea que alguien con el enlace podría publicar el resultado de una ronda
    // inventada.
    //
    // Eso se cierra en la LECTURA, no aquí: la tabla solo cuenta resultados cuyo
    // autor está en la lista de inscritos del torneo. Ver resultadosQueCuentan en
    // models/torneo.dart, que lleva la nota gemela de esta.
    //
    // LA GARANTÍA ESTÁ REPARTIDA EN DOS SITIOS, y ninguno es redundante:
    //
    //   · aquí        → quién firma, y que el organizador sea el del enlace
    //   · en la lectura → que el autor esté inscrito
    //
    // Es la lección de _BetInfo.all aplicada a seguridad. Quien lea esta regla
    // podría pensar "ya se valida la procedencia" y quitar el filtro de la
    // lectura; quien lea el filtro podría pensar "la regla ya lo hace" y quitarlo.
    // Cualquiera de las dos cosas deja que alguien con el enlace meta una fila
    // inventada en la tabla de otro. Las dos notas se nombran a propósito.
    match /torneoResultados/{docId} {
      // Lo lee el ORGANIZADOR —que es quien arma la tabla— y el autor, para
      // poder ver y corregir lo suyo. Nadie más: aquí hay ids de jugador y
      // balances, que es más de lo que la instantánea comparte.
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.torneoOwnerUid
                      || request.auth.uid == resource.data.escritoPor);

      allow create, update: if request.auth != null
                    && request.auth.uid == request.resource.data.escritoPor
                    && request.resource.data.torneoId is string
                    && request.resource.data.roundId is string
                    && request.resource.data.token is string
                    // El id del documento es {torneoId}_{roundId}: determinista,
                    // así que volver a cerrar la misma ronda ACTUALIZA en vez de
                    // añadir otra fila.
                    && docId == request.resource.data.torneoId + '_' + request.resource.data.roundId
                    && exists(/databases/$(database)/documents/sharedTorneos/$(request.resource.data.token))
                    && request.resource.data.torneoOwnerUid ==
                       get(/databases/$(database)/documents/sharedTorneos/$(request.resource.data.token)).data.ownerUid;

      // Borra el autor —se equivocó— o el organizador, que es quien responde de
      // su tabla.
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.escritoPor
                        || request.auth.uid == resource.data.torneoOwnerUid);
    }

    // ══════════════════════════════════════════════════════════════════════
    // LEADERBOARD PROYECTABLE — el ÚNICO documento que se lee sin sesión
    // ══════════════════════════════════════════════════════════════════════
    //
    // Es la pantalla de la casa club: se proyecta desde un navegador cualquiera,
    // sin cuenta, y la ve todo el que pase por delante.
    //
    // ── Por qué NO es sharedTorneos con la regla relajada ──────────────────
    //
    // sharedTorneos pide cuenta porque lleva dinero y nombres de terceros. Abrir
    // esa regla para que una tele pueda leerlo pondría los botes y los balances
    // delante de cualquiera. Así que son dos documentos: aquel sigue pidiendo
    // cuenta, y este NO LLEVA UN SOLO IMPORTE.
    //
    // La garantía es que el dato no esté, no que no se muestre. Lo que se
    // publica lo decide LeaderboardPublico, y hay un test de lista cerrada que
    // falla si alguien añade un campo sin pensarlo — que es el riesgo real: no
    // el código de hoy, sino el campo útil de dentro de seis meses.
    //
    // Y la escritura sigue siendo del dueño y solo del dueño. Lectura pública no
    // significa escritura pública.
    match /leaderboards/{token} {
      // GET, no READ. La diferencia no es cosmética.
      //
      // `read` son dos permisos: `get` (traer UN documento, que es lo que hace
      // la tele) y `list` (recorrer la colección entera). Con `read` cualquiera
      // sin cuenta puede pedir /leaderboards y recibir TODOS los torneos
      // publicados —nombre del torneo y nombre de cada participante, de todos
      // los clubes— sin tener ningún enlace. El token dejaría de ser lo que hay
      // que tener.
      //
      // Comprobado contra producción sin credenciales: con `read` el listado
      // respondía 200. La colección estaba vacía, así que no se filtró nada,
      // pero se habría llenado en cuanto el organizador publicara.
      //
      // Así que: quien tiene el enlace lee su documento; nadie recorre la
      // colección. Es la misma línea que ya sostiene sharedTorneos.
      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid
                    && request.auth.uid == request.resource.data.ownerUid;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;

      // Nada de subcolecciones, igual que en sharedTorneos: una subcolección
      // bajo un documento de lectura pública se lleva la lectura pública con
      // ella, y ahí es donde entraría el dinero sin que nadie lo revisara.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /sharedTorneos/{token} {
      // Cualquiera autenticado que tenga el enlace lee. Se pide cuenta —aunque
      // sea ligera— porque aquí hay dinero y nombres de terceros a la vista.
      allow read: if request.auth != null;

      // Solo el organizador publica, actualiza o revoca. El ownerUid se
      // comprueba contra lo que ya hay al actualizar y contra lo que se escribe
      // al crear, así que nadie puede publicar a nombre de otro ni apropiarse de
      // un token existente.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerUid;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid
                    && request.auth.uid == request.resource.data.ownerUid;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;

      // Nada de subcolecciones: si algún día hacen falta, se abren a mano. Un
      // {document=**} aquí dejaría entrar lo que nadie ha revisado.
    }

  }
}
